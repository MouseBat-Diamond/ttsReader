<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:scrollbars="vertical"
        android:textSize="18sp"
        android:textIsSelectable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/btnBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button android:id="@+id/btnOpen" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/open_file" />
        <Button android:id="@+id/btnTts" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/start_tts" />
		<Button android:id="@+id/btnBookmark" android:layout_width="0dp" android:layout_weight="1"	android:layout_height="wrap_content" android:text="string/bookmark">
        <Button android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/settings" />
        <Button android:id="@+id/btnHelp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/help" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
