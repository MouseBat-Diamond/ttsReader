<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBookmarks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/btnAdd" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="添加"/>
        <Button android:id="@+id/btnDelete" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="删除"/>
        <Button android:id="@+id/btnDeleteAll" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="删除所有"/>
    </LinearLayout>
</LinearLayout>